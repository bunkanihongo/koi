{
 "id": "story-001-ripperakugaki",
 "title": "トオルってどんな字書くのって聞いたら「徹底の…",
 "subtitle": "@ ripperakugaki の実体験 — 日本語読解",
 "level": "初級〜中級",
 "length": "1段落",
 "date": "2026-07-25",
