{
 "id": "story-020-ayugiri_ayura",
 "title": "保育園の時に男の子に誕生日聞かれて、答えたら…",
 "subtitle": "@ ayugiri_ayura の実体験 — 日本語読解",
 "level": "初級〜中級",
 "length": "2段落",
