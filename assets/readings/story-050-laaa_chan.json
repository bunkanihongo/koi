{
 "id": "story-050-laaa_chan",
 "title": "にんにく注射打つのに看護師3人やっても刺さら…",
 "subtitle": "@ laaa_chan の実体験 — 日本語読解",
 "level": "初級〜中級",
 "length": "1段落",
