{
 "id": "story-013-_WANTCHU",
 "title": "頑張ってねーって言ったら、ありがとうでも頑張…",
 "subtitle": "@ _WANTCHU の実体験 — 日本語読解",
 "level": "初級〜中級",
 "length": "1段落",
